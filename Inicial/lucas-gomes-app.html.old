<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
  <title>Lucas Coins Adventure — Guardião das Boas Atitudes</title>
  <meta name="description"
    content="App educativo e gamificado para Lucas Gomes — conquiste Lucas Coins com boas atitudes, metas e responsabilidade!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --navy: #0B1F3A;
      --navy-deep: #060f1e;
      --navy-soft: #122b4d;
      --navy-mid: #0e2240;
      --gold: #FFC93C;
      --gold-deep: #c8780a;
      --gold-bright: #FFE566;
      --gold-pale: #FFE9B0;
      --green: #2FA84F;
      --green-deep: #1B6E3C;
      --green-bright: #4cd471;
      --orange: #FF7A3D;
      --orange-deep: #E85D1F;
      --blue-bright: #3A8EF5;
      --blue-light: #5BAAFF;
      --blue-deep: #1a4c9e;
      --purple: #8B5CF6;
      --purple-deep: #5b35c5;
      --cream: #FFF8E7;
      --white: #FFFFFF;
      --ink: #0B1F3A;
      --danger: #E85D5D;
      --teal: #0ECEC6;
      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius-md: 18px;
      --radius-sm: 14px;
      --shadow-card: 0 12px 32px rgba(0, 0, 0, .38);
      --shadow-pop: 0 5px 0 rgba(0, 0, 0, .28);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      height: 100%;
    }

    body {
      font-family: 'Nunito', sans-serif;
      background:
        radial-gradient(ellipse at 18% 0%, #192f60 0%, transparent 52%),
        radial-gradient(ellipse at 88% 12%, #0d265a 0%, transparent 48%),
        radial-gradient(ellipse at 50% 100%, #091a38 0%, transparent 58%),
        linear-gradient(180deg, #06122e 0%, #091b3d 50%, #060f20 100%);
      color: var(--cream);
      min-height: 100vh;
      overflow-x: hidden;
    }

    h1,
    h2,
    h3,
    .display {
      font-family: 'Fredoka', sans-serif;
      letter-spacing: .4px;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      outline: none;
    }

    ::selection {
      background: var(--gold);
      color: var(--navy);
    }

    .star-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .star-bg span {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, .75);
      animation: twinkle var(--d, 3s) ease-in-out infinite alternate;
    }

    @keyframes twinkle {
      0% {
        opacity: .08;
        transform: scale(.6);
      }

      100% {
        opacity: .95;
        transform: scale(1.3);
      }
    }

    #app {
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      padding-bottom: 100px;
      z-index: 1;
    }

    #loading {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 22px;
      background: radial-gradient(ellipse at center, #0e2352, #040c1a);
      z-index: 9999;
    }

    .loading-coin {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 26%, #fffacc, var(--gold) 42%, var(--gold-deep) 75%, #7a4500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      color: var(--navy);
      font-size: 28px;
      animation: coinSpin 1.3s ease-in-out infinite;
      box-shadow: 0 0 60px rgba(255, 201, 60, .8), 0 0 0 6px rgba(255, 201, 60, .18), 0 8px 0 #7a4500;
      border: 3px solid rgba(255, 255, 255, .35);
      letter-spacing: -.5px;
    }

    @keyframes coinSpin {
      0% {
        transform: rotateY(0) scale(1);
      }

      45% {
        transform: rotateY(88deg) scale(.9);
      }

      55% {
        transform: rotateY(92deg) scale(.9);
      }

      100% {
        transform: rotateY(0) scale(1);
      }
    }

    .loading-brand {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 28px;
      color: var(--gold-bright);
      letter-spacing: 1px;
      text-shadow: 0 0 30px rgba(255, 229, 102, .6);
    }

    .loading-text {
      font-family: 'Fredoka';
      font-weight: 600;
      font-size: 16px;
      color: var(--gold-pale);
      text-align: center;
      animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: .5;
      }

      50% {
        opacity: 1;
      }
    }

    .loading-stars {
      display: flex;
      gap: 8px;
    }

    .loading-stars span {
      font-size: 20px;
      animation: starPop .6s ease infinite alternate;
    }

    .loading-stars span:nth-child(2) {
      animation-delay: .2s;
    }

    .loading-stars span:nth-child(3) {
      animation-delay: .4s;
    }

    @keyframes starPop {
      0% {
        transform: scale(.7) translateY(0);
      }

      100% {
        transform: scale(1.3) translateY(-5px);
      }
    }

    .topbar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 16px 10px;
      position: relative;
      z-index: 5;
      background: linear-gradient(180deg, rgba(6, 18, 46, .95) 0%, rgba(6, 18, 46, 0) 100%);
    }

    .lc-logo-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .lc-logo {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 26%, #fffacc, var(--gold) 42%, var(--gold-deep) 75%, #7a4500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 19px;
      color: var(--navy);
      border: 3px solid rgba(255, 255, 255, .4);
      box-shadow: 0 0 20px rgba(255, 201, 60, .55), 0 4px 0 #7a4500, var(--shadow-pop);
      transition: transform .2s;
      letter-spacing: -.5px;
    }

    .lc-logo:active {
      transform: scale(.93);
    }

    .lc-level-badge {
      position: absolute;
      bottom: -5px;
      right: -5px;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      border: 2px solid var(--navy-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 10px;
      color: var(--navy);
    }

    .topbar .who {
      flex: 1;
      min-width: 0;
    }

    .topbar .who .name {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 18px;
      color: var(--white);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar .who .lvl {
      font-size: 10.5px;
      color: var(--gold-pale);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .7px;
      margin-top: 1px;
    }

    .chips {
      display: flex;
      gap: 5px;
      flex-shrink: 0;
    }

    .chip {
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(10, 24, 55, .7);
      border: 1.5px solid rgba(255, 201, 60, .5);
      padding: 6px 10px;
      border-radius: 999px;
      font-weight: 900;
      font-size: 13.5px;
      color: var(--gold);
      text-shadow: 0 0 10px rgba(255, 201, 60, .5);
      box-shadow: 0 0 12px rgba(255, 201, 60, .15) inset;
    }

    .chip.streak {
      color: #FFB27A;
      border-color: rgba(255, 122, 61, .5);
      text-shadow: 0 0 10px rgba(255, 122, 61, .45);
    }

    .chip-icon {
      font-size: 15px;
    }

    .screen {
      padding: 4px 14px 24px;
      animation: fadeIn .32s ease;
    }

    .screen.hidden {
      display: none;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .section-title {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 17px;
      color: var(--gold-pale);
      margin: 22px 0 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: .3px;
    }

    .section-title .st-icon {
      font-size: 20px;
    }

    .hero-banner {
      background: radial-gradient(circle at 72% 30%, rgba(58, 142, 245, .22) 0%, transparent 55%), linear-gradient(138deg, #0d2d6a 0%, #081a45 55%, #060f30 100%);
      border: 2px solid rgba(255, 201, 60, .35);
      border-radius: var(--radius-xl);
      padding: 18px;
      margin-bottom: 4px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }

    .hero-banner::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 28% 0%, rgba(255, 201, 60, .14) 0%, transparent 55%);
      pointer-events: none;
    }

    .hero-inner {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .hero-coin {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      flex-shrink: 0;
      background: radial-gradient(circle at 32% 26%, #fffacc, var(--gold) 42%, var(--gold-deep) 75%, #7a4500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 20px;
      color: var(--navy);
      border: 3px solid rgba(255, 255, 255, .4);
      box-shadow: 0 0 30px rgba(255, 201, 60, .6), 0 5px 0 #7a4500;
      animation: heroFloat 3.2s ease-in-out infinite;
      letter-spacing: -.5px;
    }

    @keyframes heroFloat {

      0%,
      100% {
        transform: translateY(0) rotate(-1.5deg);
      }

      50% {
        transform: translateY(-7px) rotate(1.5deg);
      }
    }

    .hero-text {
      flex: 1;
    }

    .hero-title {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 21px;
      color: var(--gold-bright);
      line-height: 1.15;
      text-shadow: 0 0 20px rgba(255, 201, 60, .4);
    }

    .hero-sub {
      font-size: 12px;
      font-weight: 800;
      color: rgba(255, 255, 255, .7);
      margin-top: 3px;
      line-height: 1.4;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(255, 201, 60, .2);
      border: 1px solid rgba(255, 201, 60, .45);
      border-radius: 999px;
      padding: 4px 10px;
      font-weight: 900;
      font-size: 11px;
      color: var(--gold);
      margin-top: 7px;
    }

    .hero-pillars {
      display: flex;
      gap: 5px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .pillar {
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 999px;
      padding: 5px 10px;
      font-weight: 800;
      font-size: 10px;
      color: rgba(255, 255, 255, .82);
    }

    .pillar .p-icon {
      font-size: 12px;
    }

    .quote-card {
      background: linear-gradient(120deg, #184d2e, #1f6038 80%);
      border-radius: var(--radius-lg);
      padding: 15px 17px;
      box-shadow: var(--shadow-card);
      display: flex;
      gap: 13px;
      align-items: flex-start;
      position: relative;
      overflow: hidden;
      border: 1.5px solid rgba(78, 214, 120, .22);
    }

    .quote-card::before {
      content: '';
      position: absolute;
      right: -14px;
      top: -14px;
      width: 80px;
      height: 80px;
      background: rgba(255, 255, 255, .08);
      border-radius: 50%;
    }

    .owl-avatar {
      font-size: 42px;
      animation: owlBob 2.2s ease-in-out infinite;
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, .3));
      flex-shrink: 0;
      line-height: 1;
    }

    @keyframes owlBob {

      0%,
      100% {
        transform: rotate(-5deg);
      }

      50% {
        transform: rotate(5deg);
      }
    }

    .quote-card .qt-inner {
      flex: 1;
    }

    .quote-card p {
      margin: 0;
      font-weight: 800;
      font-style: italic;
      font-size: 13.5px;
      line-height: 1.4;
      color: var(--cream);
    }

    .quote-card .poupix-name {
      display: block;
      margin-top: 5px;
      font-size: 10.5px;
      font-weight: 900;
      color: rgba(255, 248, 231, .65);
      font-style: normal;
      text-transform: uppercase;
      letter-spacing: .7px;
    }

    .streak-banner {
      background: linear-gradient(135deg, #3a1a00, #5c2800);
      border: 1.5px solid rgba(255, 122, 61, .45);
      border-radius: var(--radius-md);
      padding: 13px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 4px;
      box-shadow: 0 4px 24px rgba(255, 122, 61, .22);
    }

    .streak-banner .sb-flame {
      font-size: 30px;
      animation: flameWave 1s ease-in-out infinite alternate;
    }

    @keyframes flameWave {
      0% {
        transform: scale(.9) rotate(-5deg);
      }

      100% {
        transform: scale(1.12) rotate(5deg);
      }
    }

    .streak-banner .sb-text {
      flex: 1;
    }

    .streak-banner .sb-count {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 26px;
      color: var(--orange);
      text-shadow: 0 0 16px rgba(255, 122, 61, .6);
    }

    .streak-banner .sb-label {
      font-size: 11px;
      font-weight: 800;
      color: rgba(255, 248, 231, .7);
    }

    .vault-card {
      position: relative;
      border-radius: var(--radius-xl);
      padding: 24px 20px 20px;
      text-align: center;
      overflow: hidden;
      background: linear-gradient(160deg, #102a52 0%, #081a36 55%, #050f22 100%);
      border: 2px solid rgba(255, 201, 60, .35);
      box-shadow: var(--shadow-card), 0 0 70px rgba(255, 201, 60, .08) inset;
    }

    .vault-glow {
      position: absolute;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(255, 201, 60, .18), transparent 68%);
      top: -130px;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .vault-coin-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 8px;
    }

    .vault-coin-big {
      width: 86px;
      height: 86px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 24%, #fffccc, var(--gold) 38%, var(--gold-deep) 65%, #7a4500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 24px;
      color: var(--navy);
      box-shadow: 0 0 50px rgba(255, 201, 60, .7), 0 8px 0 #7a4500, var(--shadow-card);
      border: 3px solid rgba(255, 255, 255, .45);
      animation: coinGlow 2.8s ease-in-out infinite;
      letter-spacing: -.5px;
    }

    @keyframes coinGlow {

      0%,
      100% {
        box-shadow: 0 0 35px rgba(255, 201, 60, .5), 0 8px 0 #7a4500, var(--shadow-card);
      }

      50% {
        box-shadow: 0 0 70px rgba(255, 201, 60, .85), 0 8px 0 #7a4500, var(--shadow-card);
      }
    }

    .vault-coin-stars {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 2px dashed rgba(255, 201, 60, .3);
      animation: rotateSlow 12s linear infinite;
    }

    @keyframes rotateSlow {
      0% {
        transform: rotate(0);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    .vault-balance {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 56px;
      color: var(--gold);
      display: block;
      line-height: 1;
      position: relative;
      z-index: 2;
      text-shadow: 0 0 30px rgba(255, 201, 60, .5);
    }

    .vault-balance-label {
      font-size: 12.5px;
      color: var(--gold-pale);
      font-weight: 800;
      position: relative;
      z-index: 2;
      margin-top: 3px;
      letter-spacing: .3px;
    }

    .vault-sub {
      font-size: 11.5px;
      color: rgba(255, 248, 231, .55);
      font-weight: 700;
      margin-top: 6px;
      position: relative;
      z-index: 2;
    }

    .vault-progress-wrap {
      margin-top: 16px;
      position: relative;
      z-index: 2;
    }

    .vault-progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 800;
      color: var(--gold-pale);
      margin-bottom: 5px;
    }

    .progress-track {
      background: rgba(255, 255, 255, .1);
      height: 13px;
      border-radius: 999px;
      overflow: hidden;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--gold-deep), var(--gold), var(--gold-bright));
      transition: width .8s cubic-bezier(.34, 1.56, .64, 1);
      position: relative;
    }

    .progress-fill::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent 28%, rgba(255, 255, 255, .65) 44%, transparent 60%);
      background-size: 220% 100%;
      animation: shine 2.4s linear infinite;
    }

    @keyframes shine {
      0% {
        background-position: 210% 0;
      }

      100% {
        background-position: -45% 0;
      }
    }

    .xp-stars {
      display: flex;
      justify-content: center;
      gap: 4px;
      margin-top: 10px;
      font-size: 17px;
    }

    .day-week-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 14px;
    }

    .dw-card {
      background: rgba(255, 255, 255, .05);
      border: 1.5px solid rgba(255, 255, 255, .1);
      border-radius: var(--radius-sm);
      padding: 12px 10px;
      text-align: center;
    }

    .dw-label {
      font-size: 10px;
      font-weight: 900;
      color: rgba(255, 248, 231, .6);
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 6px;
    }

    .dw-count {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 22px;
      color: var(--gold);
    }

    .dw-sub {
      font-size: 9.5px;
      color: rgba(255, 248, 231, .45);
      font-weight: 700;
      margin-top: 1px;
    }

    .dw-bar {
      margin-top: 7px;
    }

    .dw-bar .progress-track {
      height: 8px;
    }

    .quick-actions {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 9px;
      margin-top: 14px;
    }

    .qa-btn {
      background: linear-gradient(160deg, rgba(255, 255, 255, .1), rgba(255, 255, 255, .03));
      border: 1.5px solid rgba(255, 255, 255, .1);
      border-radius: var(--radius-md);
      padding: 13px 6px;
      text-align: center;
      color: var(--cream);
      font-weight: 800;
      font-size: 10.5px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      transition: transform .15s, box-shadow .15s;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .22);
    }

    .qa-btn:active {
      transform: scale(.92);
      box-shadow: none;
    }

    .qa-btn .qa-icon {
      font-size: 25px;
      line-height: 1;
    }

    .qa-btn.qa-gold {
      border-color: rgba(255, 201, 60, .45);
      background: linear-gradient(160deg, rgba(255, 201, 60, .16), rgba(255, 201, 60, .04));
    }

    .qa-btn.qa-blue {
      border-color: rgba(58, 142, 245, .45);
      background: linear-gradient(160deg, rgba(58, 142, 245, .16), rgba(58, 142, 245, .04));
    }

    .qa-btn.qa-green {
      border-color: rgba(47, 168, 79, .45);
      background: linear-gradient(160deg, rgba(47, 168, 79, .16), rgba(47, 168, 79, .04));
    }

    .task-row {
      display: flex;
      align-items: center;
      gap: 11px;
      background: linear-gradient(160deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .02));
      border: 1.5px solid rgba(255, 255, 255, .09);
      border-radius: var(--radius-md);
      padding: 12px 13px;
      margin-bottom: 9px;
      transition: opacity .2s, transform .15s;
      box-shadow: 0 4px 16px rgba(0, 0, 0, .14);
    }

    .task-row:active {
      transform: scale(.98);
    }

    .task-row.pending {
      opacity: .68;
      border-color: rgba(255, 201, 60, .4);
    }

    .task-row.done {
      opacity: .38;
    }

    .task-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .22);
    }

    .task-icon-wrap.green {
      background: linear-gradient(145deg, #2fa84f, #1b6e3c);
    }

    .task-icon-wrap.blue {
      background: linear-gradient(145deg, #3a8ef5, #1a5cba);
    }

    .task-icon-wrap.orange {
      background: linear-gradient(145deg, #ff7a3d, #c84e1a);
    }

    .task-icon-wrap.purple {
      background: linear-gradient(145deg, #8b5cf6, #5b35c5);
    }

    .task-icon-wrap.teal {
      background: linear-gradient(145deg, #0ecec6, #097a75);
    }

    .task-icon-wrap.gold {
      background: linear-gradient(145deg, var(--gold), var(--gold-deep));
    }

    .task-info {
      flex: 1;
      min-width: 0;
    }

    .task-info .t-label {
      font-weight: 800;
      font-size: 14px;
      color: var(--white);
      line-height: 1.25;
    }

    .task-info .t-coins {
      font-size: 11.5px;
      font-weight: 900;
      color: var(--gold);
      margin-top: 3px;
    }

    .task-info .t-coins span {
      opacity: .65;
      font-weight: 700;
      margin-left: 2px;
    }

    .task-info .t-freq {
      font-size: 10px;
      font-weight: 800;
      color: rgba(255, 248, 231, .45);
      margin-top: 2px;
      text-transform: uppercase;
      letter-spacing: .4px;
    }

    .task-status-done {
      font-size: 10px;
      font-weight: 900;
      color: var(--green-bright);
      text-transform: uppercase;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(47, 168, 79, .2);
      white-space: nowrap;
    }

    .task-status-pending {
      font-size: 10px;
      font-weight: 900;
      color: var(--gold-pale);
      text-transform: uppercase;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(255, 201, 60, .15);
      white-space: nowrap;
    }

    .btn-mark {
      background: linear-gradient(145deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      font-weight: 900;
      font-size: 11.5px;
      border-radius: 999px;
      padding: 9px 13px;
      white-space: nowrap;
      box-shadow: 0 4px 0 #7a4500;
      transition: transform .1s, box-shadow .1s;
    }

    .btn-mark:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #7a4500;
    }

    .task-row.weekly {
      border-color: rgba(14, 206, 198, .28);
      background: linear-gradient(160deg, rgba(14, 206, 198, .08), rgba(255, 255, 255, .02));
    }

    .tasks-progress-bar {
      background: rgba(255, 255, 255, .05);
      border: 1.5px solid rgba(255, 255, 255, .08);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      margin-bottom: 14px;
    }

    .tasks-progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .tasks-progress-header h4 {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 15px;
      color: var(--white);
      margin: 0;
    }

    .tasks-progress-header span {
      font-size: 12px;
      font-weight: 800;
      color: var(--gold);
    }

    .cat-progress-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      font-size: 11px;
      font-weight: 800;
      color: rgba(255, 248, 231, .6);
    }

    .cat-progress-row .progress-track {
      flex: 1;
      height: 7px;
    }

    .cat-progress-row .cp-label {
      width: 100px;
      flex-shrink: 0;
    }

    .cat-progress-row .cp-val {
      width: 30px;
      text-align: right;
      flex-shrink: 0;
      color: var(--gold);
    }

    .tab-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 12px 0 8px;
    }

    .pill {
      padding: 7px 12px;
      border-radius: 999px;
      font-weight: 800;
      font-size: 11.5px;
      background: rgba(255, 255, 255, .07);
      color: rgba(255, 248, 231, .65);
      border: 1.5px solid rgba(255, 255, 255, .1);
      transition: all .2s;
    }

    .pill.active {
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      border-color: var(--gold);
      box-shadow: 0 4px 14px rgba(255, 201, 60, .4);
    }

    .mission-card {
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 9px;
      background: linear-gradient(150deg, rgba(255, 122, 61, .13), rgba(255, 255, 255, .03));
      border: 1.5px solid rgba(255, 122, 61, .3);
      box-shadow: 0 4px 16px rgba(0, 0, 0, .14);
    }

    .mission-card.recovery {
      background: linear-gradient(150deg, rgba(139, 92, 246, .13), rgba(255, 255, 255, .03));
      border-color: rgba(139, 92, 246, .38);
    }

    .mission-card .m-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .mission-card .m-title {
      font-weight: 900;
      font-size: 15px;
      color: var(--white);
    }

    .mission-card .m-desc {
      font-size: 12px;
      color: rgba(255, 248, 231, .65);
      margin-top: 5px;
      line-height: 1.4;
    }

    .badge-coins {
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      font-weight: 900;
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 999px;
      white-space: nowrap;
      box-shadow: 0 2px 8px rgba(255, 201, 60, .4);
    }

    .grade-form {
      background: linear-gradient(150deg, rgba(58, 142, 245, .12), rgba(255, 255, 255, .03));
      border: 1.5px solid rgba(58, 142, 245, .3);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 12px;
    }

    .grade-form h4 {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 15px;
      color: var(--blue-light);
      margin: 0 0 12px;
    }

    .grade-fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .grade-band {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      margin-top: 6px;
      font-size: 12px;
      font-weight: 800;
    }

    .grade-band.ggreat {
      background: rgba(255, 201, 60, .12);
      color: var(--gold);
      border: 1px solid rgba(255, 201, 60, .25);
    }

    .grade-band.ggood {
      background: rgba(47, 168, 79, .1);
      color: var(--green-bright);
      border: 1px solid rgba(47, 168, 79, .2);
    }

    .grade-band.gavg {
      background: rgba(58, 142, 245, .1);
      color: var(--blue-light);
      border: 1px solid rgba(58, 142, 245, .2);
    }

    .grade-band.glow {
      background: rgba(232, 93, 93, .1);
      color: #ff8080;
      border: 1px solid rgba(232, 93, 93, .2);
    }

    .grade-history-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 13px;
      border-radius: var(--radius-sm);
      margin-bottom: 7px;
      background: rgba(255, 255, 255, .05);
      border: 1.5px solid rgba(255, 255, 255, .08);
    }

    .grade-subject {
      font-weight: 900;
      font-size: 14px;
      color: var(--white);
      flex: 1;
    }

    .grade-value {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 22px;
    }

    .grade-value.gvperfect,
    .grade-value.gvgreat {
      color: var(--gold);
    }

    .grade-value.gvgood {
      color: var(--green-bright);
    }

    .grade-value.gvavg {
      color: var(--blue-light);
    }

    .grade-value.gvlow {
      color: #ff8080;
    }

    .grade-lc {
      font-size: 11px;
      font-weight: 900;
      color: var(--gold);
    }

    .goal-card {
      border-radius: var(--radius-lg);
      padding: 16px;
      margin-bottom: 11px;
      background: linear-gradient(160deg, rgba(255, 255, 255, .08), rgba(255, 255, 255, .02));
      border: 1.5px solid rgba(255, 255, 255, .1);
      box-shadow: var(--shadow-card);
    }

    .goal-top {
      display: flex;
      align-items: center;
      gap: 11px;
      margin-bottom: 11px;
    }

    .goal-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(145deg, var(--orange), var(--orange-deep));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(255, 122, 61, .4);
    }

    .goal-name {
      font-weight: 900;
      font-size: 15px;
      color: var(--white);
    }

    .goal-vals {
      font-size: 12px;
      font-weight: 800;
      color: var(--gold-pale);
      margin-top: 2px;
    }

    .goal-pct {
      margin-left: auto;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 20px;
      color: var(--gold);
      text-shadow: 0 0 12px rgba(255, 201, 60, .4);
    }

    .goal-actions {
      display: flex;
      gap: 8px;
      margin-top: 11px;
    }

    .btn-sm {
      flex: 1;
      padding: 10px;
      border-radius: var(--radius-sm);
      font-weight: 900;
      font-size: 12px;
      text-align: center;
    }

    .btn-sm.primary {
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      box-shadow: 0 4px 0 #7a4500;
    }

    .btn-sm.primary:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #7a4500;
    }

    .btn-sm.ghost {
      background: rgba(255, 255, 255, .07);
      color: var(--cream);
      border: 1.5px solid rgba(255, 255, 255, .14);
    }

    .ach-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 11px;
    }

    .ach-card {
      border-radius: var(--radius-md);
      padding: 16px 11px;
      text-align: center;
      background: rgba(255, 255, 255, .04);
      border: 1.5px solid rgba(255, 255, 255, .07);
      opacity: .38;
      transition: all .3s;
    }

    .ach-card.unlocked {
      opacity: 1;
      background: linear-gradient(160deg, rgba(255, 201, 60, .17), rgba(255, 255, 255, .04));
      border-color: rgba(255, 201, 60, .5);
      box-shadow: 0 4px 24px rgba(255, 201, 60, .2);
      animation: unlockPulse 2.2s ease-in-out infinite;
    }

    @keyframes unlockPulse {

      0%,
      100% {
        box-shadow: 0 4px 22px rgba(255, 201, 60, .18);
      }

      50% {
        box-shadow: 0 4px 32px rgba(255, 201, 60, .42);
      }
    }

    .ach-badge {
      width: 58px;
      height: 58px;
      margin: 0 auto 10px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 28%, #fffccc, var(--gold) 42%, var(--gold-deep) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      box-shadow: 0 0 0 4px rgba(255, 201, 60, .22), 0 4px 18px rgba(0, 0, 0, .3);
    }

    .ach-card:not(.unlocked) .ach-badge {
      background: rgba(255, 255, 255, .07);
      box-shadow: none;
      filter: grayscale(1);
    }

    .ach-name {
      font-weight: 900;
      font-size: 12px;
      color: var(--white);
      line-height: 1.3;
    }

    .ach-desc {
      font-size: 10px;
      color: rgba(255, 248, 231, .5);
      margin-top: 4px;
      line-height: 1.3;
    }

    .level-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px;
      border-radius: var(--radius-sm);
      margin-bottom: 8px;
      background: rgba(255, 255, 255, .05);
      border: 1.5px solid rgba(255, 255, 255, .07);
      transition: all .2s;
    }

    .level-row.current {
      background: linear-gradient(150deg, rgba(255, 201, 60, .18), rgba(255, 255, 255, .04));
      border-color: var(--gold);
      box-shadow: 0 4px 22px rgba(255, 201, 60, .2);
    }

    .level-row.locked {
      opacity: .32;
    }

    .level-num {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--navy-soft);
      border: 2.5px solid var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      color: var(--gold);
      flex-shrink: 0;
      font-size: 15px;
    }

    .level-row.locked .level-num {
      border-color: rgba(255, 255, 255, .18);
      color: rgba(255, 255, 255, .28);
    }

    .level-info .l-name {
      font-weight: 900;
      font-size: 14px;
      color: var(--white);
    }

    .level-info .l-xp {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--gold-pale);
      margin-top: 2px;
    }

    .level-row .l-star {
      font-size: 22px;
      margin-left: auto;
    }

    .tabbar {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: rgba(4, 10, 22, .97);
      backdrop-filter: blur(24px);
      border-top: 1px solid rgba(255, 201, 60, .12);
      display: flex;
      padding: 8px 4px 16px;
      z-index: 50;
    }

    .tab-btn {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      background: none;
      color: rgba(255, 248, 231, .3);
      font-weight: 800;
      font-size: 9px;
      padding: 6px 2px;
      border-radius: 14px;
      transition: all .2s;
      position: relative;
    }

    .tab-btn .tb-icon {
      font-size: 23px;
      transition: transform .2s;
    }

    .tab-btn.active {
      color: var(--gold);
    }

    .tab-btn.active .tb-icon {
      transform: scale(1.22) translateY(-2px);
    }

    .tab-btn.active::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 18px;
      height: 3px;
      border-radius: 999px;
      background: var(--gold);
    }

    .tab-badge {
      position: absolute;
      top: 2px;
      right: 10px;
      min-width: 16px;
      height: 16px;
      border-radius: 999px;
      background: var(--danger);
      color: #fff;
      font-size: 9px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 3px;
    }

    #toast-container {
      position: fixed;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 28px);
      max-width: 448px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 7px;
      pointer-events: none;
    }

    .toast {
      background: linear-gradient(120deg, var(--green-deep), var(--green));
      color: var(--white);
      font-weight: 900;
      font-size: 13.5px;
      padding: 13px 16px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      display: flex;
      align-items: center;
      gap: 10px;
      animation: toastIn .28s ease, toastOut .28s ease 2.7s forwards;
    }

    .toast.gold {
      background: linear-gradient(120deg, var(--gold-deep), var(--gold));
      color: var(--navy);
    }

    .toast.blue {
      background: linear-gradient(120deg, var(--blue-deep), var(--blue-bright));
      color: var(--white);
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(-14px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes toastOut {
      to {
        opacity: 0;
        transform: translateY(-14px);
      }
    }

    .confetti-piece {
      position: fixed;
      z-index: 3000;
      pointer-events: none;
      border-radius: 2px;
      animation: confettiFall var(--dur, 2s) ease-in forwards;
    }

    @keyframes confettiFall {
      0% {
        transform: translateY(-20px) rotate(0deg);
        opacity: 1;
      }

      100% {
        transform: translateY(100vh) rotate(720deg);
        opacity: 0;
      }
    }

    .pin-gate {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      padding: 36px 8px;
    }

    .pin-coin {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 26%, #fffacc, var(--gold) 42%, var(--gold-deep) 75%, #7a4500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 22px;
      color: var(--navy);
      border: 3px solid rgba(255, 255, 255, .4);
      box-shadow: 0 0 40px rgba(255, 201, 60, .6), 0 6px 0 #7a4500;
      animation: coinGlow 2.5s ease-in-out infinite;
      letter-spacing: -.5px;
    }

    .pin-title {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 20px;
      color: var(--gold-pale);
      text-align: center;
    }

    .pin-sub {
      font-size: 12px;
      color: rgba(255, 248, 231, .5);
      font-weight: 700;
      text-align: center;
    }

    .pin-dots {
      display: flex;
      gap: 14px;
    }

    .pin-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2.5px solid var(--gold);
      background: transparent;
      transition: all .2s;
    }

    .pin-dot.filled {
      background: var(--gold);
      box-shadow: 0 0 14px rgba(255, 201, 60, .65);
    }

    .keypad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 13px;
      width: 100%;
      max-width: 280px;
    }

    .key {
      aspect-ratio: 1;
      border-radius: 50%;
      background: rgba(255, 255, 255, .08);
      border: 1.5px solid rgba(255, 255, 255, .14);
      font-family: 'Fredoka';
      font-weight: 600;
      font-size: 22px;
      color: var(--white);
      transition: all .1s;
      box-shadow: 0 3px 0 rgba(0, 0, 0, .3);
    }

    .key:active {
      background: rgba(255, 201, 60, .28);
      transform: translateY(2px);
      box-shadow: none;
    }

    .key.wide {
      background: none;
      border: none;
      color: var(--gold-pale);
      font-size: 13px;
      font-weight: 800;
      box-shadow: none;
    }

    .approve-row {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, .05);
      border-radius: var(--radius-sm);
      padding: 12px 13px;
      margin-bottom: 8px;
      border: 1.5px solid rgba(255, 255, 255, .08);
    }

    .approve-row .a-info {
      flex: 1;
    }

    .approve-row .a-title {
      font-weight: 900;
      font-size: 14px;
      color: var(--white);
    }

    .approve-row .a-sub {
      font-size: 11px;
      color: var(--gold-pale);
      font-weight: 700;
      margin-top: 2px;
    }

    .btn-approve {
      background: linear-gradient(135deg, var(--green), var(--green-deep));
      color: var(--white);
      font-weight: 900;
      font-size: 12px;
      padding: 9px 12px;
      border-radius: 999px;
      box-shadow: 0 3px 0 rgba(0, 0, 0, .3);
      white-space: nowrap;
    }

    .btn-approve:active {
      transform: translateY(2px);
      box-shadow: none;
    }

    .empty-note {
      text-align: center;
      color: rgba(255, 248, 231, .48);
      font-size: 13px;
      font-weight: 700;
      padding: 20px 10px;
      line-height: 1.5;
    }

    .form-field {
      margin-bottom: 13px;
    }

    .form-field label {
      display: block;
      font-size: 11px;
      font-weight: 900;
      color: var(--gold-pale);
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .form-field input,
    .form-field select {
      width: 100%;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, .08);
      border: 1.5px solid rgba(255, 255, 255, .14);
      color: var(--white);
      font-family: 'Nunito';
      font-weight: 700;
      font-size: 14.5px;
      transition: border-color .2s;
    }

    .form-field input:focus,
    .form-field select:focus {
      border-color: var(--gold);
      outline: none;
      box-shadow: 0 0 0 3px rgba(255, 201, 60, .2);
    }

    .form-field select option {
      background: #0e2240;
      color: var(--white);
    }

    .btn-full {
      width: 100%;
      padding: 13px;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      font-weight: 900;
      font-size: 14.5px;
      box-shadow: 0 4px 0 #7a4500;
      transition: transform .1s, box-shadow .1s;
    }

    .btn-full:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #7a4500;
    }

    .btn-full.blue {
      background: linear-gradient(135deg, var(--blue-bright), var(--blue-deep));
      color: #fff;
      box-shadow: 0 4px 0 #0e2c6e;
    }

    .btn-full.blue:active {
      box-shadow: 0 1px 0 #0e2c6e;
    }

    .chart-wrap {
      display: flex;
      align-items: flex-end;
      gap: 5px;
      height: 120px;
      padding: 10px 4px 0;
    }

    .bar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      height: 100%;
    }

    .bar {
      width: 100%;
      max-width: 28px;
      border-radius: 8px 8px 3px 3px;
      background: linear-gradient(180deg, var(--gold-bright), var(--gold-deep));
      transition: height .7s cubic-bezier(.34, 1.56, .64, 1);
      min-height: 4px;
    }

    .bar-col .bl {
      font-size: 9px;
      font-weight: 800;
      color: var(--gold-pale);
      margin-top: 5px;
    }

    .stat-mini-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 11px;
    }

    .stat-mini {
      background: rgba(255, 255, 255, .05);
      border-radius: var(--radius-sm);
      padding: 13px;
      text-align: center;
      border: 1.5px solid rgba(255, 255, 255, .08);
    }

    .stat-mini b {
      display: block;
      font-family: 'Fredoka';
      font-size: 24px;
      color: var(--gold);
      font-weight: 700;
    }

    .stat-mini span {
      font-size: 10.5px;
      font-weight: 700;
      color: rgba(255, 248, 231, .6);
    }

    .parent-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 8px;
    }

    .parent-act-btn {
      background: rgba(255, 255, 255, .06);
      border: 1.5px solid rgba(255, 255, 255, .11);
      border-radius: var(--radius-sm);
      padding: 15px 7px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      font-weight: 800;
      font-size: 11.5px;
      color: var(--cream);
      transition: all .15s;
    }

    .parent-act-btn:active {
      transform: scale(.95);
    }

    .parent-act-btn .pa-icon {
      font-size: 26px;
    }

    .modal-back {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 14, .82);
      backdrop-filter: blur(7px);
      z-index: 1000;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .modal-sheet {
      background: linear-gradient(180deg, #142448, #0c1b38);
      width: 100%;
      max-width: 480px;
      border-radius: 28px 28px 0 0;
      padding: 20px 18px 30px;
      box-shadow: 0 -12px 48px rgba(0, 0, 0, .55);
      max-height: 88vh;
      overflow-y: auto;
      animation: sheetUp .28s ease;
      border-top: 1.5px solid rgba(255, 201, 60, .22);
    }

    .modal-sheet::-webkit-scrollbar {
      width: 3px;
    }

    .modal-sheet::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, .18);
      border-radius: 999px;
    }

    @keyframes sheetUp {
      from {
        transform: translateY(55px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .modal-handle {
      width: 38px;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .18);
      margin: 0 auto 15px;
    }

    .modal-title {
      font-family: 'Fredoka';
      font-weight: 700;
      font-size: 20px;
      color: var(--white);
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-close {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .1);
      color: var(--cream);
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .chip-select {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 13px;
    }

    .chip-opt {
      padding: 8px 13px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .07);
      border: 1.5px solid rgba(255, 255, 255, .13);
      font-weight: 800;
      font-size: 12px;
      color: var(--cream);
      transition: all .15s;
      cursor: pointer;
    }

    .chip-opt.active {
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: var(--navy);
      border-color: var(--gold);
    }

    .notif-item {
      display: flex;
      gap: 10px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255, 255, 255, .07);
    }

    .notif-item:last-child {
      border-bottom: none;
    }

    .notif-item .n-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 201, 60, .15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .notif-item p {
      margin: 0;
      font-size: 13px;
      font-weight: 700;
      color: var(--cream);
      line-height: 1.4;
    }

    .notif-item span {
      font-size: 10px;
      color: rgba(255, 248, 231, .4);
      font-weight: 700;
      margin-top: 2px;
      display: block;
    }

    .footer-hint {
      text-align: center;
      font-size: 10.5px;
      color: rgba(255, 248, 231, .25);
      font-weight: 700;
      margin-top: 26px;
      padding-bottom: 8px;
    }

    .info-box {
      background: rgba(58, 142, 245, .1);
      border: 1.5px solid rgba(58, 142, 245, .25);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      margin-bottom: 12px;
      font-size: 12px;
      font-weight: 700;
      color: rgba(200, 225, 255, .8);
      line-height: 1.4;
    }

    .info-box strong {
      color: var(--blue-light);
    }

    @supports(padding:max(0px)) {
      .tabbar {
        padding-bottom: max(16px, env(safe-area-inset-bottom, 16px));
      }
    }
  </style>
</head>

<body>
  <div class="star-bg" id="star-bg"></div>
  <div id="loading">
    <div class="loading-coin">LC</div>
    <div class="loading-brand">LUCAS COINS</div>
    <div class="loading-stars"><span>⭐</span><span>🌟</span><span>⭐</span></div>
    <div class="loading-text">Carregando a aventura de Lucas…</div>
  </div>
  <div id="toast-container"></div>
  <div id="app" style="display:none;"></div>
  <script>
    /* ============================================================
       LUCAS COINS ADVENTURE — v3.0
       App educativo gamificado — identidade visual Lucas Coins
       ============================================================ */
    const STORAGE_KEY = 'lucas-coins-state-v3';
    const DAILY_TASKS = [
      { id: 'cama', label: 'Arrumar a cama', coins: 1, emoji: '🛏️', color: 'green', cat: 'Rotina' },
      { id: 'dentes', label: 'Escovar os dentes', coins: 1, emoji: '🦷', color: 'blue', cat: 'Rotina' },
      { id: 'brinquedos', label: 'Guardar os brinquedos', coins: 1, emoji: '🧸', color: 'blue', cat: 'Rotina' },
      { id: 'quarto', label: 'Organizar o quarto', coins: 2, emoji: '🏠', color: 'orange', cat: 'Rotina' },
      { id: 'mochila', label: 'Preparar a mochila escolar', coins: 2, emoji: '🎒', color: 'teal', cat: 'Rotina' },
      { id: 'licao', label: 'Fazer a lição sem reclamar', coins: 3, emoji: '📚', color: 'purple', cat: 'Escola' },
      { id: 'leitura', label: 'Ler por 20 minutos', coins: 2, emoji: '📖', color: 'green', cat: 'Escola' },
      { id: 'estudo', label: 'Estudar matéria difícil', coins: 3, emoji: '✏️', color: 'orange', cat: 'Escola' },
      { id: 'duvida', label: 'Tirar dúvida com professor', coins: 3, emoji: '🙋', color: 'blue', cat: 'Escola' },
      { id: 'caderno', label: 'Organizar cadernos e materiais', coins: 2, emoji: '📓', color: 'purple', cat: 'Escola' },
      { id: 'ajudar', label: 'Ajudar alguém espontaneamente', coins: 3, emoji: '❤️', color: 'purple', cat: 'Responsabilidade' },
      { id: 'pet', label: 'Cuidar dos Gatos', coins: 2, emoji: '🐾', color: 'green', cat: 'Responsabilidade' },
      { id: 'mesa', label: 'Arrumar a mesa do jantar', coins: 2, emoji: '🍽️', color: 'orange', cat: 'Responsabilidade' },
      { id: 'lixo', label: 'Levar o lixo para fora', coins: 2, emoji: '🗑️', color: 'teal', cat: 'Responsabilidade' },
      { id: 'vegetais', label: 'Comer vegetais sem reclamar', coins: 2, emoji: '🥦', color: 'green', cat: 'Saúde' },
      { id: 'dormir', label: 'Dormir no horário combinado', coins: 2, emoji: '😴', color: 'blue', cat: 'Saúde' },
      { id: 'exercicio', label: 'Fazer atividade física', coins: 3, emoji: '🏃', color: 'orange', cat: 'Saúde' },
      { id: 'ingles', label: 'Aprender palavra em inglês', coins: 2, emoji: '🇺🇸', color: 'teal', cat: 'Habilidades' },
      { id: 'cozinhar', label: 'Ajudar a cozinhar algo', coins: 3, emoji: '👨‍🍳', color: 'orange', cat: 'Habilidades' },
      { id: 'instrumento', label: 'Praticar instrumento musical', coins: 3, emoji: '🎵', color: 'purple', cat: 'Habilidades' },
    ];
    const WEEKLY_TASKS = [
      { id: 'w_semana', label: 'Semana completa sem atrasos na escola', coins: 10, emoji: '📅', color: 'gold' },
      { id: 'w_organiza', label: 'Organizar quarto 5x na semana', coins: 8, emoji: '🏆', color: 'gold' },
      { id: 'w_leitura7', label: 'Ler todos os dias da semana', coins: 10, emoji: '📖', color: 'gold' },
      { id: 'w_ajudas', label: 'Ajudar alguém 3 vezes na semana', coins: 8, emoji: '❤️', color: 'gold' },
      { id: 'w_semSela', label: 'Semana sem reclamar das tarefas', coins: 10, emoji: '😊', color: 'gold' },
    ];
    const SPECIAL_MISSIONS = [
      { id: 'elogio', label: 'Elogio do professor', coins: 8, desc: 'Quando a escola reconhece uma atitude positiva.' },
      { id: 'boaAcao', label: 'Boa ação registrada', coins: 5, desc: 'Um gesto bacana que os pais quiseram premiar.' },
      { id: 'projeto', label: 'Entregou tarefas no prazo', coins: 6, desc: 'Responsabilidade e comprometimento em dia.' },
      { id: 'destaque', label: 'Destaque na turma', coins: 8, desc: 'Reconhecimento da escola por mérito acadêmico.' },
    ];
    const GRADE_BANDS = [
      { label: 'Nota 10 🌟', min: 10, max: 10, coins: 12, cls: 'gvperfect', bandCls: 'ggreat' },
      { label: '9 a 9.9 ⭐', min: 9, max: 9.9, coins: 8, cls: 'gvgreat', bandCls: 'ggreat' },
      { label: '8 a 8.9 👏', min: 8, max: 8.9, coins: 6, cls: 'gvgood', bandCls: 'ggood' },
      { label: '6 a 7.9 ✅', min: 6, max: 7.9, coins: 3, cls: 'gvavg', bandCls: 'gavg' },
      { label: 'Abaixo de 6 ⚠️', min: 0, max: 5.9, coins: 0, cls: 'gvlow', bandCls: 'glow' },
    ];
    const SUBJECTS = ['Matemática', 'Português', 'Ciências', 'História', 'Geografia', 'Inglês', 'Arte', 'Ed. Física', 'Outra'];
    function gradeInfo(n) { return GRADE_BANDS.find(b => n >= b.min && n <= b.max) || GRADE_BANDS[GRADE_BANDS.length - 1]; }
    const RECOVERY_MISSIONS = {
      mentiu: { id: 'mentiu', title: '🤝 Missão Verdade', desc: 'Converse com sinceridade sobre o que aconteceu e prometa sempre dizer a verdade.', coins: 3 },
      desrespeito: { id: 'desrespeito', title: '💛 Missão Respeito', desc: 'Faça algo gentil pela pessoa envolvida e peça desculpas com atenção.', coins: 3 },
      bagunca: { id: 'bagunca', title: '🧹 Missão Organização', desc: 'Organize completamente o espaço que ficou bagunçado.', coins: 2 },
      irresponsabilidade: { id: 'irresponsabilidade', title: '⚙️ Missão Responsabilidade', desc: 'Cumpra a tarefa que foi esquecida ou negligenciada com dedicação.', coins: 2 },
    };
    const LEVELS = [
      { n: 1, name: '🌱 Aprendiz', min: 0 },
      { n: 2, name: '⚙️ Organizador Júnior', min: 50 },
      { n: 3, name: '🧭 Explorador', min: 130 },
      { n: 4, name: '🛡️ Guardião das Moedas', min: 240 },
      { n: 5, name: '🏅 Mestre das Atitudes', min: 380 },
      { n: 6, name: '🦸 Herói Financeiro', min: 550 },
    ];
    const ACHIEVEMENTS = [
      { id: 'verdade', name: 'Guardião da Verdade', desc: 'Complete 3 Missões Verdade', emoji: '🛡️', check: s => (s.counters.mentiu || 0) >= 3 },
      { id: 'organizacao', name: 'Mestre da Organização', desc: 'Organize o quarto 10 vezes', emoji: '🏆', check: s => (s.counters.quarto || 0) >= 10 },
      { id: 'leitor', name: 'Leitor da Semana', desc: 'Leia 7 dias seguidos', emoji: '📚', check: s => (s.streak || 0) >= 7 && (s.counters.leitura || 0) >= 7 },
      { id: 'ajudante', name: 'Super Ajudante', desc: 'Ajude alguém 10 vezes', emoji: '❤️', check: s => (s.counters.ajudar || 0) >= 10 },
      { id: 'economista', name: 'Economista Mirim', desc: 'Complete sua primeira meta', emoji: '🎯', check: s => s.goals.some(g => g.saved >= g.target) },
      { id: 'heroi_escola', name: 'Herói da Escola', desc: 'Registre 5 conquistas especiais', emoji: '⭐', check: s => (s.counters.specials || 0) >= 5 },
      { id: 'nota10', name: 'Craque da Prova', desc: 'Tire nota 10 em qualquer matéria', emoji: '🌟', check: s => (s.grades || []).some(g => g.nota >= 10) },
      { id: 'saudavel', name: 'Vida Saudável', desc: 'Faça exercício 5 vezes', emoji: '🏃', check: s => (s.counters.exercicio || 0) >= 5 },
    ];
    const GOAL_ICONS = { brinquedo: '🧸', livro: '📚', passeio: '🗺️', bicicleta: '🚲', presente: '🎁', jogo: '🎮', roupa: '👟', viagem: '✈️' };
    const PHRASES = [
      'Cada boa atitude hoje constrói um grande futuro amanhã! 🌟',
      'Guardar moedas é treinar a paciência de conquistar coisas grandes! 💰',
      'Um pequeno passo organizado vale mais que dez passos apressados! 🚀',
      'Ser gentil também é uma forma de ser muito corajoso! 💛',
      'Todo Guardião começou com uma primeira boa atitude! 🛡️',
      'Economizar hoje é escolher sorrir muito mais amanhã! 😊',
      'A verdade é o mapa mais confiável de qualquer aventura! 🗺️',
      'Estudar é abastecer a nave para chegar mais longe! 🛸',
      'Respeitar os outros é o tesouro mais valioso que existe! 💎',
      'Disciplina é o feitiço que transforma sonhos em conquistas! ✨',
    ];
    let state = null;
    let session = { tab: 'home', parentUnlocked: false, pinBuffer: '', taskCat: 'diarias', taskSubCat: 'todos', familyTab: 'aprovar' };
    function defaultState() { return { child: { name: 'Lucas Gomes' }, balance: 0, lifetimeXP: 0, streak: 0, lastActiveDate: null, lastWeekDate: null, pendingTasks: [], history: [], goals: [{ id: cryptoId(), name: 'Nintendo Switch', target: 2500, saved: 0, icon: 'bicicleta' }], counters: {}, unlockedAchievements: [], customMissions: [], customDailyTasks: [], activeRecoveries: [], notifications: [], parentPin: '1234', todayCompleted: [], weekCompleted: [], grades: [] }; }
    function cryptoId() { return Math.random().toString(36).slice(2, 10); }
    function todayStr() { return new Date().toISOString().slice(0, 10); }
    function weekStr() { const d = new Date(); const day = d.getDay(); const diff = d.getDate() - day + (day === 0 ? -6 : 1); const mon = new Date(d.setDate(diff)); return mon.toISOString().slice(0, 10); }
    async function loadState() {
      try { const res = await window.storage.get(STORAGE_KEY, false); if (res && res.value) { state = JSON.parse(res.value); } else { state = defaultState(); } } catch (e) { state = defaultState(); }
      if (!state.grades) state.grades = [];
      if (!state.weekCompleted) state.weekCompleted = [];
      if (!state.customDailyTasks) state.customDailyTasks = [];
      if (!state.lastWeekDate) state.lastWeekDate = null;
      rolloverDay(); rolloverWeek(); await saveState();
    }
    async function saveState() { try { await window.storage.set(STORAGE_KEY, JSON.stringify(state), false); } catch (e) { } }
    function rolloverDay() { const t = todayStr(); if (state.lastActiveDate !== t) { state.todayCompleted = []; if (state.lastActiveDate) { const diff = Math.round((new Date(t) - new Date(state.lastActiveDate)) / 86400000); if (diff > 1) state.streak = 0; } state.lastActiveDate = t; } }
    function rolloverWeek() { const w = weekStr(); if (state.lastWeekDate !== w) { state.weekCompleted = []; state.lastWeekDate = w; } }
    function currentLevel() { let l = LEVELS[0]; for (const x of LEVELS) { if (state.lifetimeXP >= x.min) l = x; } return l; }
    function nextLevel() { const c = currentLevel(); const i = LEVELS.findIndex(l => l.n === c.n); return LEVELS[i + 1] || null; }
    function levelProgressPct() { const c = currentLevel(), n = nextLevel(); if (!n) return 100; return Math.max(5, Math.min(100, Math.round((state.lifetimeXP - c.min) / (n.min - c.min) * 100))); }
    function creditCoins(amount, opts = {}) {
      state.balance += amount; state.lifetimeXP += amount;
      if (opts.counterId) state.counters[opts.counterId] = (state.counters[opts.counterId] || 0) + 1;
      if (opts.isSpecial) state.counters.specials = (state.counters.specials || 0) + 1;
      const t = todayStr(); let day = state.history.find(h => h.date === t);
      if (!day) { day = { date: t, coins: 0, tasks: 0 }; state.history.push(day); }
      day.coins += amount; day.tasks += 1;
      if (!state.todayCompleted.length && day.tasks === 1) state.streak = (state.streak || 0) + 1;
      if (opts.taskId) state.todayCompleted.push(opts.taskId);
      if (opts.weekTaskId) state.weekCompleted.push(opts.weekTaskId);
      checkAchievements(); checkLevelUp(opts.prevLevel);
    }
    function checkLevelUp(prevN) { const cur = currentLevel(); if (prevN !== undefined && cur.n > prevN) { pushNotification('Parabéns! Lucas subiu para o nível ' + cur.n + ' — ' + cur.name + '!', '🏅'); toast('🏅 Novo nível: ' + cur.name + '!', true); launchConfetti(); } }
    function checkAchievements() { ACHIEVEMENTS.forEach(a => { if (!state.unlockedAchievements.includes(a.id) && a.check(state)) { state.unlockedAchievements.push(a.id); pushNotification('Nova conquista: ' + a.name + '!', a.emoji); toast(a.emoji + ' Conquista: ' + a.name, true); launchConfetti(); } }); }
    function pushNotification(msg, ic) { state.notifications.unshift({ id: cryptoId(), msg, icon: ic || '🔔', date: new Date().toISOString(), read: false }); state.notifications = state.notifications.slice(0, 30); }
    function toast(msg, gold = false, blue = false) { const c = document.getElementById('toast-container'); const el = document.createElement('div'); el.className = 'toast' + (gold ? ' gold' : blue ? ' blue' : ''); el.innerHTML = '<span>' + (gold ? '⭐' : blue ? '📘' : '✅') + '</span><span>' + msg + '</span>'; c.appendChild(el); setTimeout(() => el.remove(), 3000); }
    function launchConfetti() { const colors = ['#FFC93C', '#FFE566', '#3A8EF5', '#2FA84F', '#FF7A3D', '#8B5CF6', '#FFFFFF', '#0ECEC6']; for (let i = 0; i < 48; i++) { const el = document.createElement('div'); el.className = 'confetti-piece'; const sz = 6 + Math.random() * 9; el.style.cssText = 'left:' + Math.random() * 100 + 'vw;top:0;width:' + sz + 'px;height:' + sz + 'px;background:' + colors[Math.floor(Math.random() * colors.length)] + ';--dur:' + (1.5 + Math.random() * 1.5) + 's;animation-delay:' + Math.random() * .5 + 's;'; document.body.appendChild(el); setTimeout(() => el.remove(), 3100); } }
    function buildStars() { const bg = document.getElementById('star-bg'); for (let i = 0; i < 70; i++) { const s = document.createElement('span'); const sz = Math.random() * 3 + .8; s.style.cssText = 'left:' + Math.random() * 100 + '%;top:' + Math.random() * 100 + '%;width:' + sz + 'px;height:' + sz + 'px;--d:' + (2 + Math.random() * 4) + 's;animation-delay:' + Math.random() * 4 + 's;'; bg.appendChild(s); } }
    function render() { document.getElementById('app').innerHTML = renderTopbar() + renderScreen() + renderTabbar(); bindEvents(); }
    function renderTopbar() { const lvl = currentLevel(); const unread = state.notifications.filter(n => !n.read).length; return '<div class="topbar"><div class="lc-logo-wrap"><div class="lc-logo">LC</div><div class="lc-level-badge">' + lvl.n + '</div></div><div class="who"><div class="name">' + state.child.name + '</div><div class="lvl">' + lvl.name + '</div></div><div class="chips"><div class="chip"><span class="chip-icon">🪙</span>' + state.balance + '</div>' + (state.streak > 0 ? '<div class="chip streak"><span class="chip-icon">🔥</span>' + state.streak + '</div>' : '') + (unread > 0 ? '<div class="chip" style="cursor:pointer;border-color:rgba(232,93,93,.5);color:#ff8888;" data-open="notifs">🔔' + unread + '</div>' : '') + '</div></div>'; }
    function renderTabbar() { const pending = state.pendingTasks.length; const tabs = [{ id: 'home', label: 'Início', icon: '🏠' }, { id: 'tasks', label: 'Missões', icon: '⚡', badge: pending }, { id: 'goals', label: 'Metas', icon: '🎯' }, { id: 'achievements', label: 'Troféus', icon: '🏆' }, { id: 'family', label: 'Família', icon: '👨‍👩‍👦' }]; return '<nav class="tabbar">' + tabs.map(t => '<button class="tab-btn ' + (session.tab === t.id ? 'active' : '') + '" data-tab="' + t.id + '"><span class="tb-icon">' + t.icon + '</span><span>' + t.label + '</span>' + (t.badge ? '<span class="tab-badge">' + t.badge + '</span>' : '') + '</button>').join('') + '</nav>'; }
    function renderScreen() { switch (session.tab) { case 'home': return renderHome(); case 'tasks': return renderTasks(); case 'goals': return renderGoals(); case 'achievements': return renderAchievements(); case 'family': return renderFamily(); default: return ''; } }
    function phraseOfDay() { const doy = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0)) / 86400000); return PHRASES[doy % PHRASES.length]; }

    function renderHome() {
      const lvl = currentLevel(), nxt = nextLevel(), pct = levelProgressPct();
      const goal = state.goals[0];
      const today = state.history.find(h => h.date === todayStr()) || { tasks: 0, coins: 0 };
      const starsCount = Math.min(5, Math.floor(pct / 20));
      const starsHtml = Array.from({ length: 5 }, (_, i) => '<span style="opacity:' + (i < starsCount ? 1 : .18) + '">⭐</span>').join('');
      const firstName = state.child.name.split(' ')[0];
      const allDaily = [...DAILY_TASKS, ...(state.customDailyTasks || [])];
      const doneToday = state.todayCompleted.filter(id => allDaily.some(t => t.id === id)).length;
      const dailyPct = allDaily.length > 0 ? Math.round(doneToday / allDaily.length * 100) : 0;
      const wDone = state.weekCompleted.filter(id => WEEKLY_TASKS.some(t => t.id === id)).length;
      const wPct = WEEKLY_TASKS.length > 0 ? Math.round(wDone / WEEKLY_TASKS.length * 100) : 0;
      return '<div class="screen">' +
        '<div class="hero-banner"><div class="hero-inner"><div class="hero-coin">LC</div><div class="hero-text"><div class="hero-title">Olá, ' + firstName + '! 👋</div><div class="hero-sub">Você é o Guardião das Boas Atitudes!</div><div class="hero-badge">🛡️ &nbsp;' + lvl.name + '</div></div></div>' +
        '<div class="hero-pillars"><span class="pillar"><span class="p-icon">🤍</span>Faça o Bem</span><span class="pillar"><span class="p-icon">💡</span>Aprenda</span><span class="pillar"><span class="p-icon">🐷</span>Economize</span><span class="pillar"><span class="p-icon">📈</span>Realize</span><span class="pillar"><span class="p-icon">⭐</span>Transforme</span></div></div>' +
        '<div class="section-title"><span class="st-icon">🦉</span>Poupix diz…</div>' +
        '<div class="quote-card"><div class="owl-avatar">🦉</div><div class="qt-inner"><p>"' + phraseOfDay() + '"</p><span class="poupix-name">🎓 Poupix, sua coruja financeira</span></div></div>' +
        (state.streak > 1 ? '<div class="streak-banner" style="margin-top:13px;"><div class="sb-flame">🔥</div><div class="sb-text"><div class="sb-count">' + state.streak + ' dias</div><div class="sb-label">Sequência incrível! Continue assim!</div></div><span style="font-size:26px;">🏅</span></div>' : '') +
        '<div class="section-title" style="margin-top:18px;"><span class="st-icon">🪙</span>Cofre de Lucas Coins</div>' +
        '<div class="vault-card"><div class="vault-glow"></div><div class="vault-coin-wrap"><div class="vault-coin-big">LC</div><div class="vault-coin-stars"></div></div>' +
        '<div class="vault-balance">' + state.balance + '</div><div class="vault-balance-label">Lucas Coins disponíveis</div><div class="vault-sub">💛 1 Lucas Coin = R$ 1,00 · guarde em metas!</div>' +
        '<div class="vault-progress-wrap"><div class="vault-progress-label"><span>' + lvl.name + '</span><span>' + (nxt ? 'Próximo: ' + nxt.name : '🏆 Nível máximo!') + '</span></div><div class="progress-track"><div class="progress-fill" style="width:' + pct + '%"></div></div><div class="xp-stars">' + starsHtml + '</div></div>' +
        '<div class="day-week-wrap">' +
        '<div class="dw-card"><div class="dw-label">⚡ Hoje</div><div class="dw-count">' + doneToday + '/' + allDaily.length + '</div><div class="dw-sub">tarefas diárias</div><div class="dw-bar"><div class="progress-track"><div class="progress-fill" style="width:' + dailyPct + '%"></div></div></div></div>' +
        '<div class="dw-card"><div class="dw-label">📅 Semana</div><div class="dw-count">' + wDone + '/' + WEEKLY_TASKS.length + '</div><div class="dw-sub">missões semanais</div><div class="dw-bar"><div class="progress-track"><div class="progress-fill" style="width:' + wPct + '%"></div></div></div></div>' +
        '</div>' +
        '<div class="quick-actions"><button class="qa-btn qa-gold" data-tab="tasks"><span class="qa-icon">⚡</span>Fazer<br>tarefas</button><button class="qa-btn qa-blue" data-tab="goals"><span class="qa-icon">🎯</span>Minhas<br>metas</button><button class="qa-btn qa-green" data-open="notifs"><span class="qa-icon">🔔</span>Avisos<br>' + (state.notifications.filter(n => !n.read).length || '') + '</button></div></div>' +
        (goal ? '<div class="section-title"><span class="st-icon">🎯</span>Meta em destaque</div><div class="goal-card">' + renderGoalInner(goal) + '</div>' : '') +
        '<div class="section-title"><span class="st-icon">📊</span>Hoje</div>' +
        '<div class="stat-mini-grid"><div class="stat-mini"><b>' + today.tasks + '</b><span>tarefas feitas</span></div><div class="stat-mini"><b>+' + today.coins + '</b><span>moedas ganhas</span></div></div>' +
        '<div class="footer-hint">Lucas Coins Adventure v3.0 · dados salvos neste dispositivo 🔒</div></div>';
    }

    function taskStatusFor(taskId) {
      if (state.todayCompleted.includes(taskId) || state.weekCompleted.includes(taskId)) return 'done';
      if (state.pendingTasks.some(p => p.taskId === taskId || p.taskId === 'week_' + taskId)) return 'pending';
      return 'open';
    }

    function renderTasks() {
      const activeCat = session.taskCat || 'diarias';
      const cats = [{ id: 'diarias', label: '📋 Diárias' }, { id: 'semanais', label: '📅 Semanais' }, { id: 'especiais', label: '⭐ Especiais' }, { id: 'notas', label: '📝 Notas' }, { id: 'recuperacao', label: '💛 Recuperação' }];
      let body = '';
      if (activeCat === 'diarias') {
        const allDaily = [...DAILY_TASKS, ...(state.customDailyTasks || [])];
        const subcats = ['todos', 'Rotina', 'Escola', 'Responsabilidade', 'Saúde', 'Habilidades'];
        const activeSub = session.taskSubCat || 'todos';
        const subPills = '<div class="tab-pills" style="margin-top:0;margin-bottom:10px;">' + subcats.map(s => '<button class="pill ' + (activeSub === s ? 'active' : '') + '" data-subcat="' + s + '">' + s + '</button>').join('') + '</div>';
        const catNames = ['Rotina', 'Escola', 'Responsabilidade', 'Saúde', 'Habilidades'];
        const catRows = catNames.map(cat => { const ct = allDaily.filter(t => t.cat === cat); const cd = ct.filter(t => state.todayCompleted.includes(t.id) || state.pendingTasks.some(p => p.taskId === t.id)).length; const p = ct.length > 0 ? Math.round(cd / ct.length * 100) : 0; return '<div class="cat-progress-row"><span class="cp-label">' + cat + '</span><div class="progress-track"><div class="progress-fill" style="width:' + p + '%"></div></div><span class="cp-val">' + cd + '/' + ct.length + '</span></div>'; }).join('');
        const doneToday = state.todayCompleted.filter(id => allDaily.some(t => t.id === id)).length;
        const wDone = state.weekCompleted.filter(id => WEEKLY_TASKS.some(t => t.id === id)).length;
        const progressHtml = '<div class="tasks-progress-bar"><div class="tasks-progress-header"><h4>📊 Progresso</h4><span>' + doneToday + '/' + allDaily.length + ' diárias · ' + wDone + '/' + WEEKLY_TASKS.length + ' semanais</span></div>' + catRows + '</div>';
        const filtered = activeSub === 'todos' ? allDaily : allDaily.filter(t => t.cat === activeSub);
        body = progressHtml + subPills + filtered.map(t => { const st = taskStatusFor(t.id); return '<div class="task-row ' + (st !== 'open' ? st : '') + '"><div class="task-icon-wrap ' + t.color + '">' + t.emoji + '</div><div class="task-info"><div class="t-label">' + t.label + '</div><div class="t-coins">🪙 ' + t.coins + ' moeda' + (t.coins > 1 ? 's' : '') + ' <span>LC</span></div><div class="t-freq">📋 Diária · ' + t.cat + '</div></div>' + (st === 'open' ? '<button class="btn-mark" data-mark="' + t.id + '">Fiz! 🙌</button>' : st === 'pending' ? '<div class="task-status-pending">⏳ Aguardando</div>' : '<div class="task-status-done">✅ Feito!</div>') + '</div>'; }).join('') +
          '<div class="empty-note" style="font-size:11px;padding:10px 0;">💡 Pais podem criar novas tarefas em Família → Registrar.</div>';
      } else if (activeCat === 'semanais') {
        body = '<div class="info-box">📅 <strong>Missões Semanais</strong> — completadas uma vez por semana. A contagem reinicia toda segunda-feira!</div>' +
          WEEKLY_TASKS.map(t => { const st = taskStatusFor(t.id); return '<div class="task-row weekly ' + (st !== 'open' ? st : '') + '"><div class="task-icon-wrap ' + t.color + '">' + t.emoji + '</div><div class="task-info"><div class="t-label">' + t.label + '</div><div class="t-coins">🪙 ' + t.coins + ' Lucas Coins</div><div class="t-freq">📅 Semanal</div></div>' + (st === 'open' ? '<button class="btn-mark" data-mark-week="' + t.id + '">Fiz! 🙌</button>' : st === 'pending' ? '<div class="task-status-pending">⏳ Aguardando</div>' : '<div class="task-status-done">✅ Feito!</div>') + '</div>'; }).join('');
      } else if (activeCat === 'especiais') {
        const all = [...SPECIAL_MISSIONS, ...state.customMissions];
        body = '<div class="info-box">⭐ <strong>Missões Especiais</strong> são registradas pelos pais na área Família → Registrar.</div>' +
          all.map(m => '<div class="mission-card"><div class="m-top"><div class="m-title">' + m.label + '</div><div class="badge-coins">🪙 +' + m.coins + '</div></div><div class="m-desc">' + (m.desc || 'Missão especial criada pela família.') + '</div></div>').join('');
      } else if (activeCat === 'notas') {
        const bandsHtml = GRADE_BANDS.map(b => '<div class="grade-band ' + b.bandCls + '"><span>' + b.label + '</span><span>' + (b.coins > 0 ? '🪙 +' + b.coins + ' LC' : 'Sem LC (missão opcional)') + '</span></div>').join('');
        const grades = (state.grades || []).slice().reverse().slice(0, 10);
        const histHtml = grades.length ? grades.map(g => { const gi = gradeInfo(g.nota); return '<div class="grade-history-item"><div><div class="grade-subject">' + g.materia + '</div><div class="grade-lc">' + (g.coins > 0 ? '🪙 +' + g.coins + ' LC ganhos' : 'Sem moedas') + '<span style="opacity:.5;margin-left:6px;font-size:10px;">' + g.date + '</span></div></div><div class="grade-value ' + gi.cls + '">' + g.nota + '</div></div>'; }).join('') : '<div class="empty-note">📝 Nenhuma nota registrada. Os pais registram em Família → Registrar Nota!</div>';
        body = '<div class="info-box">📝 <strong>Sistema de Notas</strong> — os pais registram a nota em Família → Registrar. As Lucas Coins são creditadas automaticamente!</div>' +
          '<div class="grade-form"><h4>⭐ Tabela de Recompensas por Nota</h4>' + bandsHtml + '</div>' +
          '<div class="section-title" style="margin-top:16px;"><span class="st-icon">📋</span>Histórico de Notas</div>' + histHtml;
      } else {
        if (!state.activeRecoveries.length) {
          body = '<div class="empty-note">🌟 Nenhuma Missão de Recuperação em aberto agora. Isso é ótimo!<br><br>Se as coisas saírem do combinado, os pais podem abrir uma missão aqui — sempre uma chance de recomeçar, nunca um castigo. 💛</div>';
        } else {
          body = state.activeRecoveries.map(r => { const info = RECOVERY_MISSIONS[r.type]; const pending = state.pendingTasks.some(p => p.taskId === 'rec_' + r.uid); const done = state.todayCompleted.includes('rec_' + r.uid); return '<div class="mission-card recovery"><div class="m-top"><div class="m-title">' + info.title + '</div><div class="badge-coins">🪙 +' + info.coins + '</div></div><div class="m-desc">' + info.desc + '</div>' + (!done && !pending ? '<button class="btn-mark" style="margin-top:10px;" data-mark-recovery="' + r.uid + '">Concluí! 🙌</button>' : pending ? '<div class="task-status-pending" style="margin-top:8px;display:inline-block;">⏳ Aguardando aprovação</div>' : '<div class="task-status-done" style="margin-top:8px;display:inline-block;">✅ Concluída!</div>') + '</div>'; }).join('');
        }
      }
      return '<div class="screen"><div class="section-title"><span class="st-icon">⚡</span>Missões de ' + state.child.name.split(' ')[0] + '</div><div class="tab-pills">' + cats.map(c => '<button class="pill ' + (activeCat === c.id ? 'active' : '') + '" data-taskcat="' + c.id + '">' + c.label + '</button>').join('') + '</div>' + body + '<div class="footer-hint">Tarefas vão para aprovação dos pais antes de virarem moedas. 🔐</div></div>';
    }

    function renderGoalInner(g) {
      const pct = Math.min(100, Math.round((g.saved / g.target) * 100));
      const icon = GOAL_ICONS[g.icon] || '🎁';
      return '<div class="goal-top"><div class="goal-icon-wrap">' + icon + '</div><div style="flex:1;"><div class="goal-name">' + g.name + '</div><div class="goal-vals">🪙 ' + g.saved + ' de ' + g.target + ' Lucas Coins</div></div><div class="goal-pct">' + pct + '%</div></div>' +
        '<div class="progress-track"><div class="progress-fill" style="width:' + pct + '%"></div></div>' +
        (pct >= 100 ? '<div style="text-align:center;margin-top:10px;font-size:22px;">🎉 Meta concluída! Parabéns!</div>' : '') +
        '<div class="goal-actions"><button class="btn-sm primary" data-goal-save="' + g.id + '">💰 Guardar moedas</button><button class="btn-sm ghost" data-goal-del="' + g.id + '">🗑️ Remover</button></div>';
    }
    function renderGoals() { return '<div class="screen"><div class="section-title"><span class="st-icon">🎯</span>Metas Financeiras</div>' + (state.goals.length ? state.goals.map(g => '<div class="goal-card">' + renderGoalInner(g) + '</div>').join('') : '<div class="empty-note">🎯 Nenhuma meta ainda! Que tal criar sua primeira meta?</div>') + '<button class="btn-full" data-open="newgoal" style="margin-top:8px;">✨ Criar nova meta</button><div class="footer-hint">Guardar moedas em uma meta treina a poupança de verdade! 💰</div></div>'; }

    function renderAchievements() { return '<div class="screen"><div class="section-title"><span class="st-icon">🏆</span>Conquistas de ' + state.child.name.split(' ')[0] + '</div><div class="ach-grid">' + ACHIEVEMENTS.map(a => { const un = state.unlockedAchievements.includes(a.id); return '<div class="ach-card ' + (un ? 'unlocked' : '') + '"><div class="ach-badge">' + a.emoji + '</div><div class="ach-name">' + a.name + '</div><div class="ach-desc">' + (un ? '🎉 Desbloqueada!' : a.desc) + '</div></div>'; }).join('') + '</div><div class="section-title" style="margin-top:24px;"><span class="st-icon">📈</span>Trilha de Níveis</div>' + LEVELS.map(l => { const cur = currentLevel(); const cls = l.n === cur.n ? 'current' : (l.n < cur.n ? '' : 'locked'); return '<div class="level-row ' + cls + '"><div class="level-num">' + l.n + '</div><div class="level-info"><div class="l-name">' + l.name + '</div><div class="l-xp">A partir de ' + l.min + ' moedas conquistadas</div></div>' + (l.n === cur.n ? '<span class="l-star">⭐</span>' : '<span class="l-star" style="opacity:.28">' + (l.n < cur.n ? '✅' : '🔒') + '</span>') + '</div>'; }).join('') + '</div>'; }

    function renderFamily() {
      if (!session.parentUnlocked) {
        const dots = Array.from({ length: 4 }).map((_, i) => '<div class="pin-dot ' + (i < session.pinBuffer.length ? 'filled' : '') + '"></div>').join('');
        return '<div class="screen"><div class="section-title"><span class="st-icon">👨‍👩‍👦</span>Área da Família</div><div class="pin-gate"><div class="pin-coin">LC</div><div class="pin-title">Área Exclusiva dos Pais</div><div class="pin-sub">Digite o PIN para continuar</div><div class="pin-dots">' + dots + '</div><div class="keypad">' + [1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => '<button class="key" data-pin="' + n + '">' + n + '</button>').join('') + '<button class="key wide" data-pin="clear">Limpar</button><button class="key" data-pin="0">0</button><button class="key wide" data-pin="back">⌫</button></div><p style="font-size:11px;color:rgba(255,248,231,.35);text-align:center;">PIN padrão: 1234 · altere nas configurações</p></div></div>';
      }
      const pending = state.pendingTasks;
      const activeTab = session.familyTab || 'aprovar';
      const ftabs = [{ id: 'aprovar', label: '✅ Aprovar' }, { id: 'acoes', label: '➕ Registrar' }, { id: 'relatorios', label: '📊 Relatórios' }, { id: 'config', label: '⚙️ Config' }];
      let body = '';
      if (activeTab === 'aprovar') {
        body = !pending.length ? '<div class="empty-note">✅ Nenhuma tarefa aguardando aprovação agora.<br><br>Quando Lucas marcar uma tarefa como feita, ela aparecerá aqui! 🎉</div>' : pending.map(p => { const isRec = p.taskId.startsWith('rec_'); const isWeek = p.taskId.startsWith('week_'); let title, coins; if (isRec) { const rec = state.activeRecoveries.find(r => 'rec_' + r.uid === p.taskId); const info = rec ? RECOVERY_MISSIONS[rec.type] : null; title = info ? info.title : 'Missão recuperação'; coins = info ? info.coins : 0; } else if (isWeek) { const wid = p.taskId.slice(5); const t = WEEKLY_TASKS.find(x => x.id === wid); title = t ? (t.emoji + ' ' + t.label + ' (Semanal)') : p.taskId; coins = t ? t.coins : 0; } else { const allD = [...DAILY_TASKS, ...(state.customDailyTasks || [])]; const t = allD.find(x => x.id === p.taskId); title = t ? (t.emoji + ' ' + t.label) : p.taskId; coins = t ? t.coins : 0; } return '<div class="approve-row"><div class="a-info"><div class="a-title">' + title + '</div><div class="a-sub">🪙 +' + coins + ' Lucas Coins</div></div><button class="btn-approve" data-approve="' + p.uid + '">Aprovar ✅</button></div>'; }).join('');
      } else if (activeTab === 'acoes') {
        const specials = [...SPECIAL_MISSIONS, ...state.customMissions];
        body = '<div class="section-title" style="margin:4px 0 10px;"><span class="st-icon">⭐</span>Missão Especial</div>' +
          specials.map(m => '<div class="approve-row"><div class="a-info"><div class="a-title">' + m.label + '</div><div class="a-sub">' + (m.desc || '') + ' · 🪙 +' + m.coins + ' LC</div></div><button class="btn-approve" style="background:linear-gradient(135deg,#3a8ef5,#1a5cba);" data-special="' + m.id + '">Registrar</button></div>').join('') +
          '<div class="section-title" style="margin:16px 0 10px;"><span class="st-icon">📝</span>Registrar Nota Escolar</div>' +
          '<div class="grade-form"><h4>📚 Registrar nota de prova/trabalho</h4>' +
          '<div class="grade-fields"><div class="form-field"><label>Matéria</label><select id="gf-subject">' + SUBJECTS.map(s => '<option>' + s + '</option>').join('') + '</select></div>' +
          '<div class="form-field"><label>Nota (0–10)</label><input type="number" id="gf-nota" min="0" max="10" step="0.1" placeholder="0 – 10"></div></div>' +
          '<button class="btn-full blue" id="gf-save">📝 Registrar nota e creditar LC</button></div>' +
          '<div class="parent-actions">' +
          '<button class="parent-act-btn" data-open="addcoins"><span class="pa-icon">➕</span>Adicionar moedas</button>' +
          '<button class="parent-act-btn" data-open="challenge"><span class="pa-icon">🚩</span>Criar desafio</button>' +
          '<button class="parent-act-btn" data-open="recovery"><span class="pa-icon">💛</span>Missão recuperação</button>' +
          '<button class="parent-act-btn" data-open="addtask"><span class="pa-icon">📋</span>Nova tarefa diária</button>' +
          '<button class="parent-act-btn" style="border-color:rgba(232,93,93,.35);" data-deduct><span class="pa-icon">➖</span>Descontar moedas</button>' +
          '</div>';
      } else if (activeTab === 'relatorios') {
        body = renderReports();
      } else {
        body = '<div class="form-field"><label>Nome da criança</label><input type="text" id="cfg-name" value="' + state.child.name + '" placeholder="Nome"></div>' +
          '<div class="form-field"><label>Novo PIN (4 dígitos)</label><input type="number" id="cfg-pin" placeholder="0000" maxlength="4"></div>' +
          '<button class="btn-full" id="cfg-save">💾 Salvar configurações</button>' +
          '<button class="btn-full" id="cfg-lock" style="margin-top:10px;background:linear-gradient(135deg,#e85d5d,#a33030);box-shadow:0 4px 0 #6b1515;">🔒 Bloquear área dos pais</button>' +
          '<div class="footer-hint" style="margin-top:18px;">Lucas Coins Adventure v3.0</div>';
      }
      return '<div class="screen"><div class="section-title"><span class="st-icon">👨‍👩‍👦</span>Área da Família</div><div class="tab-pills">' + ftabs.map(t => '<button class="pill ' + (activeTab === t.id ? 'active' : '') + '" data-ftab="' + t.id + '">' + t.label + '</button>').join('') + '</div>' + body + '</div>';
    }

    function renderReports() {
      const last7 = []; for (let i = 6; i >= 0; i--) { const d = new Date(); d.setDate(d.getDate() - i); const ds = d.toISOString().slice(0, 10); const h = state.history.find(x => x.date === ds); last7.push({ label: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'][d.getDay()], coins: h ? h.coins : 0 }); }
      const mx = Math.max(...last7.map(d => d.coins), 1);
      const bars = last7.map(d => '<div class="bar-col"><div class="bar" style="height:' + Math.round(d.coins / mx * 80 + 4) + 'px"></div><div class="bl">' + d.label + '</div></div>').join('');
      const total7 = last7.reduce((s, d) => s + d.coins, 0);
      const grades = state.grades || [];
      const avgNota = grades.length > 0 ? (grades.reduce((s, g) => s + g.nota, 0) / grades.length).toFixed(1) : '—';
      const totalGradeLC = grades.reduce((s, g) => s + g.coins, 0);
      const gradeHistHtml = grades.length ? grades.slice().reverse().slice(0, 5).map(g => { const gi = gradeInfo(g.nota); return '<div class="grade-history-item"><div><div class="grade-subject">' + g.materia + '</div><div class="grade-lc">' + g.date + '</div></div><div class="grade-value ' + gi.cls + '">' + g.nota + '</div></div>'; }).join('') : '<div class="empty-note" style="padding:12px 0;">Nenhuma nota registrada.</div>';
      return '<div class="section-title" style="margin:6px 0 10px;"><span class="st-icon">📊</span>Moedas (7 dias)</div>' +
        '<div style="background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.08);border-radius:var(--radius-md);padding:15px;"><div class="chart-wrap">' + bars + '</div></div>' +
        '<div class="stat-mini-grid"><div class="stat-mini"><b>' + state.balance + '</b><span>saldo atual</span></div><div class="stat-mini"><b>' + total7 + '</b><span>moedas em 7 dias</span></div><div class="stat-mini"><b>' + (state.streak || 0) + '</b><span>dias seguidos 🔥</span></div><div class="stat-mini"><b>' + currentLevel().n + '/6</b><span>nível atual</span></div></div>' +
        '<div class="section-title" style="margin-top:20px;"><span class="st-icon">📝</span>Notas Escolares</div>' +
        '<div class="stat-mini-grid"><div class="stat-mini"><b>' + avgNota + '</b><span>média das notas</span></div><div class="stat-mini"><b>' + totalGradeLC + ' LC</b><span>moedas por notas</span></div></div>' +
        gradeHistHtml;
    }

    function openModal(html) { const back = document.createElement('div'); back.className = 'modal-back'; back.id = 'modal-back'; back.innerHTML = '<div class="modal-sheet"><div class="modal-handle"></div>' + html + '</div>'; back.addEventListener('click', e => { if (e.target === back) closeModal(); }); document.body.appendChild(back); }
    function closeModal() { const m = document.getElementById('modal-back'); if (m) m.remove(); }
    function modalNotifs() { state.notifications.forEach(n => n.read = true); saveState(); const items = state.notifications.length ? state.notifications.map(n => '<div class="notif-item"><div class="n-icon">' + (n.icon || '🔔') + '</div><div><p>' + n.msg + '</p><span>' + new Date(n.date).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) + '</span></div></div>').join('') : '<div class="empty-note">🔔 Sem avisos por enquanto.</div>'; openModal('<div class="modal-title">🔔 Avisos <button class="modal-close" data-close>✕</button></div>' + items); }
    function modalNewGoal() { openModal('<div class="modal-title">✨ Nova meta <button class="modal-close" data-close>✕</button></div><div class="form-field"><label>Ícone da meta</label><div class="chip-select" id="goal-icon-select">' + Object.entries(GOAL_ICONS).map(([k, v], i) => '<div class="chip-opt ' + (i === 0 ? 'active' : '') + '" data-icon="' + k + '">' + v + ' ' + k + '</div>').join('') + '</div></div><div class="form-field"><label>Nome da meta</label><input type="text" id="ng-name" placeholder="Ex: Bicicleta nova"></div><div class="form-field"><label>Valor total (Lucas Coins)</label><input type="number" id="ng-target" min="1" placeholder="Ex: 100"></div><button class="btn-full" id="ng-save">🎯 Criar meta</button>'); let sel = Object.keys(GOAL_ICONS)[0]; document.getElementById('goal-icon-select').addEventListener('click', e => { const c = e.target.closest('.chip-opt'); if (!c) return; document.querySelectorAll('#goal-icon-select .chip-opt').forEach(x => x.classList.remove('active')); c.classList.add('active'); sel = c.dataset.icon; }); document.getElementById('ng-save').addEventListener('click', () => { const name = document.getElementById('ng-name').value.trim(); const target = parseInt(document.getElementById('ng-target').value); if (!name || !target || target < 1) { toast('Preencha o nome e o valor da meta!'); return; } state.goals.push({ id: cryptoId(), name, target, saved: 0, icon: sel }); saveState(); closeModal(); render(); toast('Meta criada! 🎯', true); }); }
    function modalGoalSave(goalId) { const g = state.goals.find(x => x.id === goalId); if (!g) return; openModal('<div class="modal-title">💰 Guardar em "' + g.name + '" <button class="modal-close" data-close>✕</button></div><p style="font-size:13px;color:var(--gold-pale);font-weight:700;margin-top:-8px;">Saldo disponível: ' + state.balance + ' LC</p><div class="form-field"><label>Quanto guardar</label><input type="number" id="gs-amount" min="1" max="' + state.balance + '" placeholder="Ex: 10"></div><button class="btn-full" id="gs-save">💰 Guardar moedas</button>'); document.getElementById('gs-save').addEventListener('click', () => { const amt = parseInt(document.getElementById('gs-amount').value); if (!amt || amt < 1) { toast('Digite um valor válido!'); return; } if (amt > state.balance) { toast('Saldo insuficiente! 😅'); return; } state.balance -= amt; g.saved += amt; checkAchievements(); if (g.saved >= g.target) { toast('🎉 Meta "' + g.name + '" concluída!', true); pushNotification('Meta "' + g.name + '" foi concluída!', '🎯'); launchConfetti(); } else { toast('💰 ' + amt + ' LC guardadas em "' + g.name + '"'); } saveState(); closeModal(); render(); }); }
    function modalAddCoins() { openModal('<div class="modal-title">➕ Adicionar moedas <button class="modal-close" data-close>✕</button></div><div class="form-field"><label>Quantidade</label><input type="number" id="ac-amount" min="1" placeholder="Ex: 5"></div><div class="form-field"><label>Motivo</label><input type="text" id="ac-reason" placeholder="Ex: Ajudou a lavar o carro"></div><button class="btn-full" id="ac-save">✅ Adicionar</button>'); document.getElementById('ac-save').addEventListener('click', () => { const amt = parseInt(document.getElementById('ac-amount').value); const reason = document.getElementById('ac-reason').value.trim() || 'Bônus dos pais'; if (!amt || amt < 1) { toast('Digite uma quantidade válida!'); return; } const prevLevel = currentLevel().n; creditCoins(amt, { prevLevel }); pushNotification('Você ganhou ' + amt + ' moedas: ' + reason, '🪙'); saveState(); closeModal(); render(); toast('🪙 +' + amt + ' LC adicionadas!', true); }); }
    function modalDeduct() { openModal('<div class="modal-title">➖ Descontar moedas <button class="modal-close" data-close>✕</button></div><p style="font-size:12px;color:rgba(255,248,231,.65);font-weight:700;margin-top:-8px;">Use com sabedoria e explique o motivo para Lucas.</p><div class="form-field"><label>Quantidade</label><input type="number" id="dc-amount" min="1" max="' + state.balance + '" placeholder="Ex: 3"></div><div class="form-field"><label>Motivo</label><input type="text" id="dc-reason" placeholder="Ex: Quebrou algo sem querer"></div><button class="btn-full" id="dc-save" style="background:linear-gradient(135deg,#e85d5d,#a33030);box-shadow:0 4px 0 #6b1515;">➖ Descontar</button>'); document.getElementById('dc-save').addEventListener('click', () => { const amt = parseInt(document.getElementById('dc-amount').value); const reason = document.getElementById('dc-reason').value.trim() || 'Desconto'; if (!amt || amt < 1) { toast('Digite um valor válido!'); return; } if (amt > state.balance) { toast('Saldo insuficiente!'); return; } state.balance -= amt; pushNotification('Foram descontadas ' + amt + ' moedas: ' + reason, '➖'); saveState(); closeModal(); render(); toast('➖ ' + amt + ' LC descontadas.'); }); }
    function modalChallenge() { openModal('<div class="modal-title">🚩 Criar desafio <button class="modal-close" data-close>✕</button></div><div class="form-field"><label>Nome do desafio</label><input type="text" id="ch-name" placeholder="Ex: Arrumar a garagem"></div><div class="form-field"><label>Valor em moedas</label><input type="number" id="ch-coins" min="1" placeholder="Ex: 6"></div><div class="form-field"><label>Descrição (opcional)</label><input type="text" id="ch-desc" placeholder="Ex: Limpar e organizar tudo"></div><button class="btn-full" id="ch-save">🚩 Criar desafio</button>'); document.getElementById('ch-save').addEventListener('click', () => { const name = document.getElementById('ch-name').value.trim(); const coins = parseInt(document.getElementById('ch-coins').value); const desc = document.getElementById('ch-desc').value.trim(); if (!name || !coins || coins < 1) { toast('Preencha nome e valor!'); return; } state.customMissions.push({ id: 'custom_' + cryptoId(), label: name, coins, desc: desc || 'Desafio criado pela família.' }); saveState(); closeModal(); render(); toast('🚩 Desafio criado!', true); }); }
    function modalRecovery() { openModal('<div class="modal-title">💛 Missão recuperação <button class="modal-close" data-close>✕</button></div><p style="font-size:12px;color:rgba(255,248,231,.65);font-weight:700;margin-top:-8px;">Sem punições: uma missão dá a Lucas um caminho positivo para recomeçar.</p><div class="form-field"><label>Situação</label><div class="chip-select" id="rec-type-select"><div class="chip-opt active" data-rt="mentiu">😔 Mentiu</div><div class="chip-opt" data-rt="desrespeito">😤 Desrespeitou alguém</div><div class="chip-opt" data-rt="bagunca">🌀 Bagunçou o quarto</div><div class="chip-opt" data-rt="irresponsabilidade">⚙️ Foi irresponsável</div></div></div><button class="btn-full" id="rec-save">💛 Abrir missão</button>'); let sel = 'mentiu'; document.getElementById('rec-type-select').addEventListener('click', e => { const c = e.target.closest('.chip-opt'); if (!c) return; document.querySelectorAll('#rec-type-select .chip-opt').forEach(x => x.classList.remove('active')); c.classList.add('active'); sel = c.dataset.rt; }); document.getElementById('rec-save').addEventListener('click', () => { state.activeRecoveries.push({ uid: cryptoId(), type: sel, date: todayStr(), status: 'aberta' }); pushNotification('Uma nova ' + RECOVERY_MISSIONS[sel].title + ' foi aberta.', '💛'); saveState(); closeModal(); render(); toast('💛 Missão de recuperação aberta.', true); }); }
    function modalAddTask() { openModal('<div class="modal-title">📋 Nova tarefa diária <button class="modal-close" data-close>✕</button></div><div class="form-field"><label>Nome da tarefa</label><input type="text" id="at-name" placeholder="Ex: Regar as plantas"></div><div class="form-field"><label>Emoji</label><input type="text" id="at-emoji" placeholder="🌱" maxlength="2" style="font-size:22px;text-align:center;"></div><div class="form-field"><label>Moedas (valor)</label><input type="number" id="at-coins" min="1" max="20" placeholder="Ex: 2"></div><div class="form-field"><label>Categoria</label><select id="at-cat"><option>Rotina</option><option>Escola</option><option>Responsabilidade</option><option>Saúde</option><option>Habilidades</option></select></div><button class="btn-full" id="at-save">✅ Criar tarefa</button>'); document.getElementById('at-save').addEventListener('click', () => { const name = document.getElementById('at-name').value.trim(); const emoji = document.getElementById('at-emoji').value.trim() || '⭐'; const coins = parseInt(document.getElementById('at-coins').value) || 1; const cat = document.getElementById('at-cat').value; if (!name) { toast('Digite o nome da tarefa!'); return; } const colorMap = { Rotina: 'teal', Escola: 'purple', Responsabilidade: 'green', Saúde: 'blue', Habilidades: 'orange' }; state.customDailyTasks = state.customDailyTasks || []; state.customDailyTasks.push({ id: 'ctask_' + cryptoId(), label: name, emoji, coins, color: colorMap[cat] || 'blue', cat }); saveState(); closeModal(); render(); toast('📋 Nova tarefa criada!', true); }); }

    function bindEvents() {
      document.querySelectorAll('[data-tab]').forEach(el => el.addEventListener('click', () => { session.tab = el.dataset.tab; render(); }));
      document.querySelectorAll('[data-taskcat]').forEach(el => el.addEventListener('click', () => { session.taskCat = el.dataset.taskcat; session.taskSubCat = 'todos'; render(); }));
      document.querySelectorAll('[data-subcat]').forEach(el => el.addEventListener('click', () => { session.taskSubCat = el.dataset.subcat; render(); }));
      document.querySelectorAll('[data-ftab]').forEach(el => el.addEventListener('click', () => { session.familyTab = el.dataset.ftab; render(); }));
      document.querySelectorAll('[data-mark]').forEach(el => el.addEventListener('click', () => { const taskId = el.dataset.mark; if (state.pendingTasks.some(p => p.taskId === taskId) || state.todayCompleted.includes(taskId)) return; state.pendingTasks.push({ uid: cryptoId(), taskId, date: todayStr() }); saveState(); render(); toast('📨 Enviado para aprovação dos pais!'); }));
      document.querySelectorAll('[data-mark-week]').forEach(el => el.addEventListener('click', () => { const taskId = el.dataset.markWeek; const pid = 'week_' + taskId; if (state.pendingTasks.some(p => p.taskId === pid) || state.weekCompleted.includes(taskId)) return; state.pendingTasks.push({ uid: cryptoId(), taskId: pid, date: todayStr() }); saveState(); render(); toast('📨 Missão semanal enviada para aprovação!'); }));
      document.querySelectorAll('[data-mark-recovery]').forEach(el => el.addEventListener('click', () => { const uid = el.dataset.markRecovery; const pid = 'rec_' + uid; if (state.pendingTasks.some(p => p.taskId === pid)) return; state.pendingTasks.push({ uid: cryptoId(), taskId: pid, date: todayStr() }); saveState(); render(); toast('📨 Missão enviada para aprovação!'); }));
      document.querySelectorAll('[data-goal-save]').forEach(el => el.addEventListener('click', () => modalGoalSave(el.dataset.goalSave)));
      document.querySelectorAll('[data-goal-del]').forEach(el => el.addEventListener('click', () => { if (!confirm('Remover esta meta?')) return; state.goals = state.goals.filter(g => g.id !== el.dataset.goalDel); saveState(); render(); }));
      document.querySelectorAll('[data-open]').forEach(el => el.addEventListener('click', () => { const w = el.dataset.open; if (w === 'notifs') modalNotifs(); if (w === 'newgoal') modalNewGoal(); if (w === 'addcoins') modalAddCoins(); if (w === 'challenge') modalChallenge(); if (w === 'recovery') modalRecovery(); if (w === 'addtask') modalAddTask(); }));
      document.querySelectorAll('[data-deduct]').forEach(el => el.addEventListener('click', () => modalDeduct()));
      document.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', closeModal));
      document.querySelectorAll('[data-approve]').forEach(el => el.addEventListener('click', () => {
        const uid = el.dataset.approve; const p = state.pendingTasks.find(x => x.uid === uid); if (!p) return; const prevLevel = currentLevel().n;
        if (p.taskId.startsWith('rec_')) { const recUid = p.taskId.slice(4); const rec = state.activeRecoveries.find(r => r.uid === recUid); if (rec) { const info = RECOVERY_MISSIONS[rec.type]; creditCoins(info.coins, { counterId: rec.type, prevLevel, taskId: 'rec_' + recUid }); state.activeRecoveries = state.activeRecoveries.filter(r => r.uid !== recUid); pushNotification('Missão concluída: ' + info.title + '. +' + info.coins + ' moedas!', '💛'); toast('💛 Missão concluída! +' + info.coins + ' LC', true); } }
        else if (p.taskId.startsWith('week_')) { const wid = p.taskId.slice(5); const t = WEEKLY_TASKS.find(x => x.id === wid); if (t) { creditCoins(t.coins, { counterId: t.id, weekTaskId: t.id, prevLevel }); pushNotification('Missão semanal aprovada: ' + t.label + '. +' + t.coins + ' moedas!', '📅'); toast('📅 Semanal aprovada! +' + t.coins + ' LC 🎉', true); launchConfetti(); } }
        else { const allD = [...DAILY_TASKS, ...(state.customDailyTasks || [])]; const t = allD.find(x => x.id === p.taskId); if (t) { creditCoins(t.coins, { counterId: t.id, taskId: t.id, prevLevel }); pushNotification('Tarefa aprovada: ' + t.label + '. +' + t.coins + ' moedas!', '✅'); toast('✅ Aprovado! +' + t.coins + ' LC 🎉', true); launchConfetti(); } }
        state.pendingTasks = state.pendingTasks.filter(x => x.uid !== uid); saveState(); render();
      }));
      document.querySelectorAll('[data-special]').forEach(el => el.addEventListener('click', () => { const id = el.dataset.special; const m = [...SPECIAL_MISSIONS, ...state.customMissions].find(x => x.id === id); if (!m) return; const prevLevel = currentLevel().n; creditCoins(m.coins, { isSpecial: true, prevLevel }); pushNotification('Missão registrada: ' + m.label + '. +' + m.coins + ' moedas!', '⭐'); saveState(); render(); toast('⭐ +' + m.coins + ' LC registradas!', true); launchConfetti(); }));
      const gfSave = document.getElementById('gf-save');
      if (gfSave) gfSave.addEventListener('click', () => { const materia = document.getElementById('gf-subject').value; const notaRaw = parseFloat(document.getElementById('gf-nota').value); if (isNaN(notaRaw) || notaRaw < 0 || notaRaw > 10) { toast('Digite uma nota válida entre 0 e 10!'); return; } const nota = Math.round(notaRaw * 10) / 10; const gi = gradeInfo(nota); const prevLevel = currentLevel().n; state.grades = state.grades || []; state.grades.push({ id: cryptoId(), materia, nota, coins: gi.coins, date: todayStr() }); if (gi.coins > 0) { creditCoins(gi.coins, { isSpecial: true, prevLevel }); pushNotification('Nota ' + nota + ' em ' + materia + '! +' + gi.coins + ' Lucas Coins! 📚', '📝'); toast('📝 Nota ' + nota + ' — +' + gi.coins + ' LC!', false, true); if (nota >= 10) launchConfetti(); } else { pushNotification('Nota ' + nota + ' em ' + materia + '. Vamos estudar mais! 💪', '📝'); toast('📝 Nota ' + nota + ' registrada. Bora recuperar! 💪'); } saveState(); render(); });
      const cfgSave = document.getElementById('cfg-save'); if (cfgSave) cfgSave.addEventListener('click', () => { const name = document.getElementById('cfg-name').value.trim(); const pin = document.getElementById('cfg-pin').value.trim(); if (name) state.child.name = name; if (pin && /^\d{4}$/.test(pin)) state.parentPin = pin; saveState(); render(); toast('⚙️ Configurações salvas!', true); });
      const cfgLock = document.getElementById('cfg-lock'); if (cfgLock) cfgLock.addEventListener('click', () => { session.parentUnlocked = false; session.pinBuffer = ''; render(); });
      document.querySelectorAll('[data-pin]').forEach(el => el.addEventListener('click', () => { const v = el.dataset.pin; if (v === 'clear') session.pinBuffer = ''; else if (v === 'back') session.pinBuffer = session.pinBuffer.slice(0, -1); else if (session.pinBuffer.length < 4) session.pinBuffer += v; if (session.pinBuffer.length === 4) { if (session.pinBuffer === state.parentPin) { session.parentUnlocked = true; session.pinBuffer = ''; session.familyTab = 'aprovar'; } else { toast('PIN incorreto, tente novamente! 🔒'); session.pinBuffer = ''; } } render(); }));
    }

    (async function init() {
      buildStars();
      await loadState();
      document.getElementById('loading').style.display = 'none';
      document.getElementById('app').style.display = 'flex';
      render();
    })();
  </script>
</body>

</html>